# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3010
NODE_ENV=development

# Base URL used for public file uploads, images, and links in emails
# Development: http://localhost:3010
# Production:  https://api.agarwalgroup.in
APP_BASE_URL=http://localhost:3010

# ==========================================
# DATABASE (MySQL / Sequelize)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=database_development
DB_USER=root
DB_PASSWORD=rootpassword

# ==========================================
# JWT AUTHENTICATION SECRETS
# ==========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# ==========================================
# EMAIL SMTP CONFIGURATION (Hostinger)
# ==========================================
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=no-reply@agarwalgroup.in
# Note: Wrap in double quotes if password contains special characters (like '#')
EMAIL_PASS="your_email_password_here"
EMAIL_FROM="Agarwal Group" <no-reply@agarwalgroup.in>

# Optional Public Contact Phones (PDF templates omit call sentences if left blank)
SALES_PHONE=+919876543210
PARTNER_PHONE=+919876543211
PROCUREMENT_PHONE=+919876543212

# Admin Notification Recipient (Receives callback, brochure, HR alerts)
ADMIN_EMAIL=paramount@gmail.com

# Sales Forwarding BCC (Receives blind copies of customer inquiries/alerts)
SALES_BCC_EMAIL=sales@agarwalgroup.in

# ==========================================
# GOOGLE SHEETS SYNC WEBHOOKS
# ==========================================
# Google Apps Script webhooks for auto-syncing CRM data
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your_general_webhook_id/exec
GOOGLE_SHEET_SALES_WEBHOOK_URL=https://script.google.com/macros/s/your_sales_webhook_id/exec
GOOGLE_SHEET_HR_WEBHOOK_URL=https://script.google.com/macros/s/your_hr_webhook_id/exec
